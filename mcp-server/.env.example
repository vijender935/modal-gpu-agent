# Render / MCP gateway
# The MCP gateway is connector-accessible without a gateway token.
MODAL_ENDPOINT_TOKEN=replace-with-the-token-configured-in-Modal
MCP_REQUESTS_PER_SECOND=0.2
MCP_BURST_CAPACITY=5

# Modal web function endpoints
IMAGE_ENDPOINT=https://your-image-endpoint.modal.run
GPU_ENDPOINT=https://your-gpu-endpoint.modal.run
SANDBOX_ENDPOINT=https://your-sandbox-endpoint.modal.run
PROCESS_ENDPOINT=https://your-process-endpoint.modal.run
ASYNC_PROCESS_ENDPOINT=https://your-async-process-endpoint.modal.run
STATUS_ENDPOINT=https://your-drive-status-endpoint.modal.run
